# Large binary publication assets use Git LFS. Text, YAML and checksum records
# remain ordinary Git objects so provenance and review history stay diffable.
art/canonical/**/*.png filter=lfs diff=lfs merge=lfs -text
art/canonical/**/*.tif filter=lfs diff=lfs merge=lfs -text
art/canonical/**/*.psd filter=lfs diff=lfs merge=lfs -text
art/keyframes/**/*.png filter=lfs diff=lfs merge=lfs -text
art/keyframes/**/*.tif filter=lfs diff=lfs merge=lfs -text
art/keyframes/**/*.psd filter=lfs diff=lfs merge=lfs -text
art/scenes/**/*.png filter=lfs diff=lfs merge=lfs -text
art/scenes/**/*.tif filter=lfs diff=lfs merge=lfs -text
art/scenes/**/*.psd filter=lfs diff=lfs merge=lfs -text
characters/**/*.png filter=lfs diff=lfs merge=lfs -text
characters/**/*.tif filter=lfs diff=lfs merge=lfs -text
characters/**/*.psd filter=lfs diff=lfs merge=lfs -text
book/**/*.pdf filter=lfs diff=lfs merge=lfs -text
video/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
video/**/*.mov filter=lfs diff=lfs merge=lfs -text
video/**/*.wav filter=lfs diff=lfs merge=lfs -text
video/**/*.flac filter=lfs diff=lfs merge=lfs -text
